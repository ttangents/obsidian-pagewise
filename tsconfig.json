{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2021",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "noImplicitAny": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "lib": ["DOM", "ES2021"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "api/**/*.ts"]
}
